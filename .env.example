# Ein Abo (wie bisher)
ICAL_FEED_URL=https://dein-ical-feed-url

# Mehrere Abos: komma-, semikolon- oder zeilengetrennt (https oder webcal)
# ICAL_FEED_URLS=https://kalender-a...,webcal://kalender-b...

# Optional übersichtlicher (Vercel, Coolify …): weitere Variablen ICAL_FEED_URL_2 … ICAL_FEED_URL_10

# Nur zur Fehlersuche: Stichprobe geparster Termine ins Server-Log (enthält Kalenderinhalte)
# CALCONNY_DEBUG_ICS=1
